# Build artifacts (通用)
*.o
*.a
*.so
*.dylib

# Debug info
*.dSYM/

# Core dumps
core
core.*
vgcore.*

# Editor & IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── 每个实验目录有自己的 .gitignore ───
# 采用白名单模式：忽略目录下所有文件，只放行源码、文档、构建文件
# 这样无论可执行文件叫什么名字都会被自动忽略

# Perf output
perf.data
perf.data.old
*.perf

# Perfetto traces
*.perfetto-trace

# Third-party binaries (not tracked in git)
lib/perfetto/

# Valgrind logs
valgrind-*.log

# strace / ltrace output
*.strace
*.ltrace

# Temporary files
/tmp/
*.tmp
*.bak
*.orig
